<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contoso Expense AI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Claims" asp-action="Index">
            <span class="brand-mark">C</span>
            <span>Contoso Expense AI</span>
        </a>
        <div class="user-chip">Employee Portal</div>
    </header>
    <div class="shell">
        <aside class="sidebar">
            <a class="nav-link active" asp-controller="Claims" asp-action="Index">Expense claims</a>
            <span class="nav-link muted">Policy library</span>
            <span class="nav-link muted">Approvals</span>
            <div class="sidebar-note">AI assists.<br />Humans decide.</div>
        </aside>
        <main class="main-content">@RenderBody()</main>
    </div>
</body>
</html>
